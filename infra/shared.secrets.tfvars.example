# Fuente única de los secretos que Azure y GCP comparten (ADR-0023).
#
# Copiá este archivo a `infra/shared.secrets.tfvars` (ya está en .gitignore,
# nunca se commitea) y completá los valores con un editor de texto normal —
# NO lo tipees en el chat ni en un comando `!`: cualquier texto que pase por
# ahí queda en la transcripción de la conversación.
#
# `infra/rotate-secrets.sh` lo usa para correr `terraform plan`/`apply` en
# infra/azure e infra/gcp con el mismo valor, en un solo paso — así rotar
# una clave deja de ser "dos operaciones que hay que acordarse de hacer"
# (ver docs/incidentes/0001, y el 401 de Anthropic/Gemini del día
# siguiente: los dos fueron exactamente este olvido).
#
# `image`/`image_tag` NO van acá: el script los detecta solo contra lo que
# ya está corriendo en cada nube, para no pisar un deploy de CD reciente.

ghcr_username     = "Nicolas-Torres"
ghcr_token        = ""
database_url      = ""
anthropic_api_key = ""
gemini_api_key    = ""
langsmith_api_key = ""
