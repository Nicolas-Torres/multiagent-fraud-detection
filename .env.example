# Solo para tu contenedor local (los lee compose por interpolación)
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_DB=fraud
POSTGRES_PORT=5432

# Lo único que la app conoce (variable del contrato)
# Nube (RDS): requiere ?sslmode=require — la instancia rechaza conexiones sin TLS
DATABASE_URL=postgresql+psycopg://fraud:fraud@localhost:5432/fraud
LOG_LEVEL=INFO
# Habilita las operaciones destructivas (seed.py --reset). Ausente = bloqueadas.
ENVIRONMENT=local

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Observabilidad de LLM (ADR-0013, entregable 6). Opcionales: sin clave o
# con LANGSMITH_TRACING=false, no se traza nada y el sistema funciona igual.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=fraud-detection

# Observabilidad de infra: HTTP + DB (ADR-0024). Vacío = sin instrumentar,
# ni un intento de conexión. Con el stack local levantado
# (`docker compose -f compose.yml -f observability/compose.observability.yml up -d`),
# usar el receptor OTLP de Alloy:
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fraud-detection-api